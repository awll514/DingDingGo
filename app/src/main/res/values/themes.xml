<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      应用主题（浅色 · 默认）。

      启动链路必须与主题一致，否则会出现"深色闪一下再变浅色"的跳变：
        系统 Splash（纯色）→ Activity windowBackground → LaunchOverlay → 首页
      这四个环节的颜色必须来自**同一套主题**。

      浅色用 #E8F0FB（GlassColors.backgroundDeep），
      深色版本在 values-night/themes.xml 里覆盖。
    -->
    <style name="Theme.AutoAttend" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
      系统 SplashScreen（API 31+）。

      windowSplashScreenAnimationDuration = 0：图标静止显示，不做缩放动画。
      这样既有视觉锚点，又不会因为动画排期拖慢窗口切换。
    -->
    <style name="Theme.AutoAttend.Splash" parent="Theme.AutoAttend">
        <item name="android:windowSplashScreenBackground">#E8F0FB</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>

</resources>