<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景层。

  之前只有前景、背景是纯黑，看起来像"人物浮在虚空里"。
  现在做三层：
    1. 深蓝夜色渐变底（衬托蓝发）；
    2. 中心柔光晕（让角色有"站在光里"的感觉）；
    3. 底部像素风网格地平线（呼应像素钉钉娘的视觉语言）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. 夜色渐变底 -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108">
                <item android:offset="0" android:color="#16233D" />
                <item android:offset="0.55" android:color="#0D1728" />
                <item android:offset="1" android:color="#070C16" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. 中心柔光晕（径向渐变，衬托角色） -->
    <path android:pathData="M54,52 m-42,0 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="52"
                android:gradientRadius="44">
                <item android:offset="0" android:color="#335A9EE8" />
                <item android:offset="0.6" android:color="#1530608F" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. 底部像素网格（呼应像素风） -->
    <path android:fillColor="#0B1424" android:pathData="M0,88 h108 v20 h-108 z" />
    <path android:fillColor="#12203A" android:pathData="M0,88 h108 v2 h-108 z" />
    <!-- 网格竖线 -->
    <path android:fillColor="#1A2C4C" android:pathData="M12,90 h2 v18 h-2 z" />
    <path android:fillColor="#1A2C4C" android:pathData="M30,90 h2 v18 h-2 z" />
    <path android:fillColor="#1A2C4C" android:pathData="M48,90 h2 v18 h-2 z" />
    <path android:fillColor="#1A2C4C" android:pathData="M66,90 h2 v18 h-2 z" />
    <path android:fillColor="#1A2C4C" android:pathData="M84,90 h2 v18 h-2 z" />
    <path android:fillColor="#1A2C4C" android:pathData="M100,90 h2 v18 h-2 z" />
    <!-- 网格横线 -->
    <path android:fillColor="#1A2C4C" android:pathData="M0,97 h108 v2 h-108 z" />

    <!-- 4. 左上、右上角淡淡的像素星点 -->
    <path android:fillColor="#4A6FA5" android:pathData="M18,18 h3 v3 h-3 z" />
    <path android:fillColor="#2F4A72" android:pathData="M86,26 h2 v2 h-2 z" />
    <path android:fillColor="#3D5C8A" android:pathData="M24,34 h2 v2 h-2 z" />
    <path android:fillColor="#2F4A72" android:pathData="M78,14 h2 v2 h-2 z" />
</vector>
