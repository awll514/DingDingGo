<?xml version="1.0" encoding="utf-8"?>
<!--
  Window 背景：与首页流动背景的深色基调一致。
  作用是在 Compose 首帧之前就占满屏幕，避免白色/黑色闪屏。
  用渐变而不是纯色，视觉上更接近成品。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#04070F"
        android:centerColor="#0A1526"
        android:endColor="#071320" />
</shape>
