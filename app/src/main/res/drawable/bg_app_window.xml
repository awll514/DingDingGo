<?xml version="1.0" encoding="utf-8"?>
<!--
   浅色主题的窗口背景。
   与 GlassColors.LightGlassColors 的 backgroundDeep(#E8F0FB) 一致，
   确保从系统 Splash 切到 Activity 时没有色差跳变。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#E8F0FB"
        android:centerColor="#F2F7FE"
        android:endColor="#E2ECFA" />
</shape>
